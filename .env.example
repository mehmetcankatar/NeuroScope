# Environment variables; the launcher reads .env automatically.
NEUROSCOPE_DATA_DIR=./data
NEUROSCOPE_HOST=127.0.0.1
NEUROSCOPE_PORT=8000
NEUROSCOPE_MAX_UPLOAD_MB=512
# Configure after obtaining authorized checkpoints:
# NEUROSCOPE_MODEL_REGISTRY=./models/registry.json
# NEUROSCOPE_MORGOTH_PYTHON=/absolute/path/to/morgoth-env/bin/python
NEUROSCOPE_DEVICE=cpu
